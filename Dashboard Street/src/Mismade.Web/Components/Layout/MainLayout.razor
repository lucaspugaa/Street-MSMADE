@inherits LayoutComponentBase

<div class="shell">
    <aside class="side">
        <div class="brand">
            <strong>MISMADE</strong>
            <span>Street · panel interno</span>
        </div>
        <nav aria-label="Navegación principal">
            <NavLink href="/" Match="NavLinkMatch.All">Inicio</NavLink>
            <NavLink href="/stock">Stock</NavLink>
            <NavLink href="/movimientos">Movimientos</NavLink>
            <NavLink href="/finanzas">Finanzas</NavLink>
            <NavLink href="/campanas">Campañas</NavLink>
            <NavLink href="/clientes">Clientes</NavLink>
        </nav>
        <div class="side-foot">
            <AuthorizeView>
                <span class="who">Sesión de <strong>@context.User.Identity?.Name</strong></span>
            </AuthorizeView>
            <form method="post" action="/Account/Logout">
                <AntiforgeryToken />
                <button type="submit" class="link-btn">Salir</button>
            </form>
        </div>
    </aside>
    <main class="content">@Body</main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Ocurrió un error. <a href="." class="reload">Recargar</a>
    <span class="dismiss">×</span>
</div>
