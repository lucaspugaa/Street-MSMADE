@page "/"
@attribute [Authorize]
@rendermode InteractiveServer
@implements IDisposable
@inject IJobRunStore Runs
@inject IDashboardNotifier Notifier
@inject ISyncQueue Queue
@inject AuthenticationStateProvider Authentication
@inject ITiendanubeCredenciales Credenciales
@inject ITiendanubeClient Tiendanube
@inject IOptions<MetaOptions> Meta
@inject IMetaInsightStore MetaInsights
@inject IDbContextFactory<MismadeDbContext> Db

<PageTitle>Inicio · MISMADE</PageTitle>

<header class="page-head">
    <span class="eyebrow">@HoyArt()</span>
    <h1>Hola@(string.IsNullOrEmpty(usuario) ? "" : $", {usuario}")</h1>
    <p>Desde acá ves si los datos están al día y qué falta conectar para que el panel se complete.</p>
</header>

@if (notaTiendanube is not null)
{
    <div class="note" role="status">@notaTiendanube</div>
}

<div class="grid">
    <section class="card" aria-labelledby="sync-title">
        <div class="card-head">
            <h2 id="sync-title">Sincronización con Tiendanube y Meta</h2>
            <span class="pill @EstadoClase">@EstadoTexto</span>
        </div>

        <dl class="facts">
            <div>
                <dt>Última corrida</dt>
                <dd class="num">@(ultima is null ? "—" : HoraArt(ultima.FinishedAt ?? ultima.StartedAt))</dd>
            </div>
            <div>
                <dt>Quién la disparó</dt>
                <dd>@(ultima is null ? "—" : OrigenTexto(ultima.Trigger))</dd>
            </div>
            <div>
                <dt>Próxima automática</dt>
                <dd class="num">@ProximaCorrida()</dd>
            </div>
            @if (ultima is not null && ultima.Status != EstadoJob.Skipped)
            {
                <div>
                    <dt>Pedidos nuevos</dt>
                    <dd class="num">@ultima.OrdersProcessed</dd>
                </div>
                @if (detalle is { ModoSombra: true })
                {
                    <div>
                        <dt>Stock en Tiendanube</dt>
                        <dd>Modo sombra · @detalle.PoolsSimulados.Count sin enviar</dd>
                    </div>
                }
                else
                {
                    <div>
                        <dt>Stock actualizado en Tiendanube</dt>
                        <dd class="num">@ultima.CombinationsPushed @(ultima.CombinationsPushed == 1 ? "combinación" : "combinaciones")</dd>
                    </div>
                }
            }
        </dl>

        @if (detalle is { Alertas.Count: > 0 })
        {
            <div class="note bad">
                <b>Revisá el stock:</b>
                <ul class="alerts">
                    @foreach (var alerta in detalle.Alertas)
                    {
                        <li>@TextoAlerta(alerta)</li>
                    }
                </ul>
            </div>
        }

        @if (detalle is { Notas.Count: > 0 })
        {
            <ul class="run-notes">
                @foreach (var nota in detalle.Notas)
                {
                    <li>@nota</li>
                }
            </ul>
        }

        @if (ultima?.Status == EstadoJob.Failed && !string.IsNullOrEmpty(ultima.Error))
        {
            <div class="note bad">La última sincronización falló. Los datos pueden estar desactualizados.</div>
            <details>
                <summary>Ver el error técnico</summary>
                <pre>@ultima.Error</pre>
            </details>
        }
        else if (Faltantes.Count > 0)
        {
            <div class="note warn">
                Para que el panel muestre todo falta @Lista(Faltantes). Mirá «Qué está conectado».
            </div>
        }

        <AuthorizeView Roles="Owner">
            <div class="actions">
                <button class="btn" @onclick="SincronizarAsync" disabled="@(encolando || corriendo)">
                    @(corriendo ? "Sincronizando…" : "Sincronizar ahora")
                </button>
                <span class="muted" role="status">@mensaje</span>
            </div>
        </AuthorizeView>
    </section>

    <section class="card" aria-labelledby="setup-title">
        <div class="card-head">
            <h2 id="setup-title">Qué está conectado</h2>
            <span class="pill @(listos == checks.Count ? "ok" : "warn")">@listos de @checks.Count listos</span>
        </div>
        <ul class="checks">
            @foreach (var check in checks)
            {
                <li>
                    <span class="mark @(check.Ok ? "ok" : "no")" aria-hidden="true">@(check.Ok ? "✓" : "!")</span>
                    <div>
                        <b>@check.Nombre</b>
                        <span>@(check.Ok ? check.SiOk : check.SiFalta)</span>
                    </div>
                </li>
            }
        </ul>
        @if (!tiendanubeConectada)
        {
            <AuthorizeView Roles="Owner">
                <a href="/tiendanube/conectar" class="btn ghost" data-enhance-nav="false">Conectar Tiendanube</a>
            </AuthorizeView>
        }
    </section>
</div>

@code {
    private static readonly TimeZoneInfo Ar = TimeZoneInfo.FindSystemTimeZoneById("America/Argentina/Buenos_Aires");

    private record Check(string Nombre, bool Ok, string SiOk, string SiFalta, string Corto);

    private JobRun? ultima;
    private bool encolando;
    private string? mensaje;
    private string? usuario;
    private bool disposed;
    private SyncDetalle? detalle;
    private bool tiendanubeConectada;
    [SupplyParameterFromQuery(Name = "tiendanube")]
    public string? TiendanubeResultado { get; set; }
    private string? notaTiendanube => TiendanubeResultado switch
    {
        "ok" => "Tiendanube quedó conectada.",
        "error" => "No se pudo conectar Tiendanube. Probá de nuevo.",
        "config" => "Faltan Tiendanube__AppId y Tiendanube__ClientSecret en Render.",
        _ => null
    };
    private List<Check> checks = [];

    private bool corriendo => ultima?.Status == EstadoJob.Running;
    private int listos => checks.Count(c => c.Ok);

    private List<string> Faltantes => checks.Where(c => !c.Ok).Select(c => c.Corto).ToList();

    private static string Lista(List<string> items) => items.Count switch
    {
        1 => items[0],
        _ => string.Join(", ", items[..^1]) + " y " + items[^1]
    };

    private static SyncDetalle? LeerDetalle(JobRun? run)
    {
        if (string.IsNullOrEmpty(run?.Detalle))
        {
            return null;
        }

        try
        {
            return System.Text.Json.JsonSerializer.Deserialize<SyncDetalle>(run.Detalle);
        }
        catch (System.Text.Json.JsonException)
        {
            return null;
        }
    }

    private static string TextoAlerta(AlertaDetalle alerta) => alerta.Tipo == "Sobreventa"
        ? $"{PoolKeys.Legible(alerta.Pool)}: se vendieron {alerta.Faltante} más de las que había."
        : $"{PoolKeys.Legible(alerta.Pool)} se quedó sin stock.";

    protected override async Task OnInitializedAsync()
    {
        Notifier.Refrescar += Refrescar;
        usuario = (await Authentication.GetAuthenticationStateAsync()).User.Identity?.Name;
        ultima = await Runs.GetLatestAsync(CancellationToken.None);
        detalle = LeerDetalle(ultima);
        await CargarChecksAsync();
    }

    private async Task CargarChecksAsync()
    {
        var meta = Meta.Value;
        var tiendanubeOk = await Credenciales.GetAsync(CancellationToken.None) is not null;
        tiendanubeConectada = tiendanubeOk;
        var tienda = "Conectada";
        if (tiendanubeOk)
        {
            try
            {
                tienda = $"Conectada a {await Tiendanube.GetStoreNameAsync(CancellationToken.None)}";
            }
            catch (Exception)
            {
                tienda = "Conectada";
            }
        }
        var metaOk = !string.IsNullOrWhiteSpace(meta.SystemUserToken)
            && !string.IsNullOrWhiteSpace(meta.StreetAccountId) && !string.IsNullOrWhiteSpace(meta.KumoAccountId);

        await using var db = await Db.CreateDbContextAsync();
        var stockCargado = await db.StockRemeras.AnyAsync();
        var metaTexto = "Falta configurar: cargá el token y las cuentas Street y Kumo.";
        if (metaOk)
        {
            var ultimaMeta = await db.JobRuns.AsNoTracking()
                .Where(x => x.FinishedAt != null && x.Detalle != null && x.Detalle.Contains("\"Meta\":[{"))
                .OrderByDescending(x => x.StartedAt).FirstOrDefaultAsync();
            var resultados = LeerDetalle(ultimaMeta)?.Meta;
            var errores = resultados?.Where(x => x.Estado == "error").ToList();
            metaOk = resultados is not null && new[] { CuentaMeta.Street, CuentaMeta.Kumo }
                .All(cuenta => resultados.Any(x => x.Cuenta == cuenta && x.Estado == "ok"));

            if (errores is { Count: > 0 })
            {
                metaTexto = "Error: " + string.Join("; ", errores.Select(x => $"{x.Cuenta}: {x.Mensaje}"));
            }
            else if (metaOk)
            {
                var (desde, hasta) = MetaSyncVentana.Calcular(true, DateTimeOffset.UtcNow);
                var street = await MetaInsights.GastoAsync(CuentaMeta.Street, desde, hasta, CancellationToken.None);
                var kumo = await MetaInsights.GastoAsync(CuentaMeta.Kumo, desde, hasta, CancellationToken.None);
                var cultura = new System.Globalization.CultureInfo("es-AR");
                metaTexto = $"OK · {HoraArt(ultimaMeta!.FinishedAt!.Value)} · Gasto últimos 7 días: "
                    + $"Street {street.ToString("C", cultura)} · Kumo {kumo.ToString("C", cultura)}";
            }
            else
            {
                metaTexto = "Configurado, sin sincronizar ambas cuentas.";
            }
        }

        checks =
        [
            new("Base de datos", true, "Conectada y al día.", "", "la base de datos"),
            new("Tiendanube", tiendanubeOk,
                tienda,
                "Falta conectar Tiendanube.", "conectar Tiendanube"),
            new("Meta Ads (Street y Kumo)", metaOk,
                metaTexto, metaTexto, "sincronizar Meta Ads"),
            new("Datos del dashboard anterior", stockCargado,
                "Stock importado.",
                "Falta importar el stock, las ventas en negro y el resto de la información del dashboard actual.",
                "importar los datos del dashboard anterior"),
        ];
    }

    private void Refrescar() => _ = InvokeAsync(async () =>
    {
        if (!disposed)
        {
            ultima = await Runs.GetLatestAsync(CancellationToken.None);
            detalle = LeerDetalle(ultima);
            await CargarChecksAsync();
            if (ultima?.Status != EstadoJob.Running)
            {
                mensaje = ultima?.Status == EstadoJob.Failed ? "Terminó con error." : "Listo.";
            }
            StateHasChanged();
        }
    });

    private async Task SincronizarAsync()
    {
        var state = await Authentication.GetAuthenticationStateAsync();
        if (!state.User.IsInRole("Owner"))
        {
            return;
        }

        encolando = true;
        mensaje = "Pedido enviado. Esta pantalla se actualiza sola cuando termine.";
        try
        {
            await Queue.EnqueueAsync("UI");
        }
        finally
        {
            encolando = false;
        }
    }

    private string EstadoTexto => ultima?.Status switch
    {
        null => "Nunca corrió",
        EstadoJob.Running => "En curso",
        EstadoJob.Succeeded => "Completada",
        EstadoJob.Failed => "Falló",
        EstadoJob.Skipped => "Omitida (ya había otra en curso)",
        _ => ultima.Status.ToString()
    };

    private string EstadoClase => ultima?.Status switch
    {
        EstadoJob.Running => "run",
        EstadoJob.Succeeded => "ok",
        EstadoJob.Failed => "bad",
        _ => ""
    };

    private static string OrigenTexto(string trigger) => trigger switch
    {
        "UI" => "Manual, desde el panel",
        "Endpoint" or "Hangfire" => "Automática",
        _ => trigger
    };

    private static DateTime AhoraArt() => TimeZoneInfo.ConvertTime(DateTimeOffset.UtcNow, Ar).DateTime;

    private static string HoyArt() =>
        AhoraArt().ToString("dddd d 'de' MMMM", new System.Globalization.CultureInfo("es-AR"));

    private static string HoraArt(DateTimeOffset fecha)
    {
        var local = TimeZoneInfo.ConvertTime(fecha, Ar).DateTime;
        var dia = local.Date == AhoraArt().Date ? "Hoy" : local.Date == AhoraArt().Date.AddDays(-1) ? "Ayer" : local.ToString("dd/MM");
        return $"{dia} {local:HH:mm}";
    }

    // Las corridas automáticas son a las 00:01 y 18:01, hora argentina.
    private static string ProximaCorrida()
    {
        var ahora = AhoraArt();
        var candidatas = new[] { ahora.Date.AddMinutes(1), ahora.Date.AddHours(18).AddMinutes(1), ahora.Date.AddDays(1).AddMinutes(1) };
        var proxima = candidatas.First(c => c > ahora);
        return $"{(proxima.Date == ahora.Date ? "Hoy" : "Mañana")} {proxima:HH:mm}";
    }

    public void Dispose()
    {
        disposed = true;
        Notifier.Refrescar -= Refrescar;
    }
}
