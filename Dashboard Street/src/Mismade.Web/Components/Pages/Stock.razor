@page "/stock"
@attribute [Authorize]
@inject IDbContextFactory<MismadeDbContext> Db

<PageTitle>Stock · MISMADE</PageTitle>

<header class="page-head">
    <span class="eyebrow">Remeras · pool compartido</span>
    <h1>Stock</h1>
    <p>Unidades reales por color, corte y talle. Cada número se comparte entre todos los diseños que usan esa remera lisa.</p>
</header>

@if (remeras.Count == 0)
{
    <EmptyState Titulo="El stock de remeras todavía no está cargado"
                Texto="Acá vas a ver una tabla por corte (Regular y Oversize) con cada color y talle, en verde, amarillo o rojo según cuánto queda."
                Falta="@(["Importar el stock actual desde el dashboard anterior.", "Conectar Tiendanube, para que cada venta descuente sola."])" />
}
else
{
    <div class="legend" aria-label="Referencias">
        <span><i style="background: var(--ok)"></i>Más de 20</span>
        <span><i style="background: var(--warn)"></i>De 10 a 20</span>
        <span><i style="background: var(--bad)"></i>Menos de 10</span>
    </div>

    @foreach (var corte in remeras.Select(r => r.Corte).Distinct().OrderBy(c => c))
    {
        var filas = remeras.Where(r => r.Corte == corte).ToList();
        var talles = OrdenTalles(filas.Select(r => r.Talle).Distinct());
        <section class="card">
            <div class="card-head">
                <h2>@corte</h2>
                <span class="muted num">@filas.Sum(r => r.Stock) unidades</span>
            </div>
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th scope="col">Color</th>
                            @foreach (var talle in talles)
                            {
                                <th scope="col" class="c">@talle</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var color in filas.Select(r => r.Color).Distinct().OrderBy(c => c))
                        {
                            <tr>
                                <th scope="row">@color</th>
                                @foreach (var talle in talles)
                                {
                                    var item = filas.FirstOrDefault(r => r.Color == color && r.Talle == talle);
                                    <td class="c">
                                        @if (item is null)
                                        {
                                            <span class="qty none">—</span>
                                        }
                                        else
                                        {
                                            <span class="qty @Semaforo(item.Stock)">@item.Stock</span>
                                        }
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }
}

@code {
    private static readonly string[] Orden = ["XS", "S", "M", "L", "XL", "XXL", "XXXL"];
    private List<StockRemera> remeras = [];

    protected override async Task OnInitializedAsync()
    {
        await using var db = await Db.CreateDbContextAsync();
        remeras = await db.StockRemeras.AsNoTracking().ToListAsync();
    }

    // Regla de negocio del semáforo: rojo < 10, amarillo 10-20, verde > 20.
    private static string Semaforo(int stock) => stock < 10 ? "bad" : stock <= 20 ? "warn" : "ok";

    private static List<string> OrdenTalles(IEnumerable<string> talles) => talles
        .OrderBy(t => Array.IndexOf(Orden, t.ToUpperInvariant()) is var i && i >= 0 ? i : int.MaxValue)
        .ThenBy(t => t)
        .ToList();
}
