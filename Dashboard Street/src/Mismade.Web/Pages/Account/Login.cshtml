@page
@model Mismade.Web.Pages.Account.LoginModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
<!DOCTYPE html>
<html lang="es">
<head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><title>Ingresar · MISMADE</title><link rel="stylesheet" href="/app.css" /></head>
<body><main>
    <h1>Ingresar a MISMADE / Street</h1>
    <form method="post">
        <div asp-validation-summary="All" role="alert"></div>
        <label asp-for="Usuario">Usuario</label>
        <input asp-for="Usuario" autocomplete="username" required />
        <label asp-for="Clave">Contraseña</label>
        <input asp-for="Clave" type="password" autocomplete="current-password" required />
        <button type="submit">Ingresar</button>
    </form>
</main></body></html>
