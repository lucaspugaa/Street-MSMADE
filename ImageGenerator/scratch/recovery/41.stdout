Existing graph: False
   1: // Recorta la prenda de un mockup con fondo liso y la compone sobre un fondo nuevo.
   2: // Copia del núcleo de Tienda Street/scripts/mocks/generar.mjs (npm run mocks:generar).
   3: import sharp from 'sharp';
   4: // Ojo: en sharp, erode() agranda las zonas blancas de una máscara y dilate() las achica
   5: // (la morfología de libvips toma el negro como figura). Acá: erode = agrandar, dilate = achicar.
   6: import { readFile } from 'node:fs/promises';
   7: import { createRequire } from 'node:module';
   8: import { dirname, join } from 'node:path';
   9: import { pathToFileURL } from 'node:url';
  10: 
  11: // Modelo local de recorte (modo "preciso"): se carga recién cuando se usa. No redibuja la imagen,
  12: // solo decide qué píxeles son prenda; los colores salen de la foto original.
  13: let removeBackground;
  14: async function modelMask(pngBytes) {
  15:   const name = '@imgly/background-removal-node';
  16:   if (!removeBackground) {
  17:     try {
  18:       ({ removeBackground } = await import(name));
  19:     } catch {
  20:       throw new Error('falta el modelo de recorte preciso: ejecutá npm install en ImageGenerator, o usá el recorte rápido');
  21:     }
  22:   }
  23:   const dist = dirname(createRequire(import.meta.url).resolve(name));
  24:   const blob = await removeBackground(new Blob([pngBytes], { type: 'image/png' }), {
  25:     publicPath: `${pathToFileURL(join(dist, '/')).href}`,
  26:     model: 'medium',
  27:     output: { format: 'image/png' },
  28:   });
  29:   return sharp(Buffer.from(await blob.arrayBuffer())).ensureAlpha().extractChannel(3).raw().toBuffer({ resolveWithObject: true });
  30: }
  31: 
  32: export const DEFAULTS = {
  33:   fondo: '#1c1c1c',
  34:   ancho: 1200,
  35:   alto: 1500,
  36:   escala: 0.78,
  37:   posicion_vertical: 0.5,
  38:   recorte: 'preciso',
  39:   tolerancia: 8,
  40:   recortar_borde: 1,
  41:   rellenar_bordes: 8,
  42:   suavizar_contorno: 3,
  43:   borde_suave: 0.6,
  44:   quitar_huecos: false,
  45:   sombra_original: true,
  46:   sombra: { opacidad: 0.45, desenfoque: 22, x: 0, y: 16 },
  47: };
  48: 
  49: export function merge(...layers) {
  50:   const result = { ...DEFAULTS, sombra: { ...DEFAULTS.sombra } };
  51:   for (const layer of layers.filter(Boolean)) {
  52:     for (const [key, value] of Object.entries(layer)) {
  53:       result[key] = key === 'sombra' && value ? { ...result.sombra, ...value } : value;
  54:     }
  55:   }
  56:   return result;
  57: }
